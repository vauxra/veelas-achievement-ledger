<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.34</Version>
    <AssemblyName>AchieveExPlus</AssemblyName>
    <RootNamespace>AchievementTracker</RootNamespace>
    <Authors>Saagi</Authors>
    <PackageProjectUrl>https://github.com/vauxra/achieve-ex</PackageProjectUrl>
    <IconUrl>https://raw.githubusercontent.com/vauxra/achieve-ex/main/AchievementTracker/images/icon.png</IconUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <!-- AllowUnsafeBlocks is required for isolated ClientStructs adapters; see https://dalamud.dev/plugin-development/interaction/. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="images/icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PatchDalamudManifestIconDebug" AfterTargets="DefaultDalamudPackagerDebug">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/patch_manifest_icon.py&quot; &quot;$(OutputPath)$(AssemblyName).json&quot; &quot;$(OutputPath)$(AssemblyName)/latest.zip&quot; &quot;$(IconUrl)&quot;" />
  </Target>
  <Target Name="PatchDalamudManifestIconRelease" AfterTargets="DefaultDalamudPackagerRelease">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../scripts/patch_manifest_icon.py&quot; &quot;$(OutputPath)$(AssemblyName).json&quot; &quot;$(OutputPath)$(AssemblyName)/latest.zip&quot; &quot;$(IconUrl)&quot;" />
  </Target>
</Project>
